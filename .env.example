# ===========================================
# Schizophrenia AI Platform - Environment Variables
# ===========================================
# TEMPLATE ONLY — safe example configuration.
# Copy to .env for local development and adjust as needed.
# NEVER commit .env or real credentials to version control.
# Production deployments require separate secure configuration.
# ===========================================

# -------------------------------------------
# General
# -------------------------------------------
NODE_ENV=development
PYTHON_ENV=development
LOG_LEVEL=debug

# -------------------------------------------
# Security
# -------------------------------------------
# Local development placeholders ONLY.
# Generate unique secrets for your local .env.
# Production must reject these placeholders.
#
# Generate random values with:
# openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption key: use the exact encoding and key length
# required by your application's encryption implementation.
# Never use this placeholder as a real key.
ENCRYPTION_KEY=REPLACE_WITH_VALID_ENCRYPTION_KEY

# -------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------
# Local Docker development defaults ONLY.
# Keep these synchronized with docker-compose.yml.
# Do not use these credentials in production.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=schizophrenia_ai
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql://dev:dev@postgres:5432/schizophrenia_ai

# Production: configure a strong unique database password,
# private network access, and TLS/SSL as appropriate.
# Never put real production credentials in this file.

# -------------------------------------------
# Redis (Job Queue & Caching)
# -------------------------------------------
# Local development defaults. Configure authentication
# if required by your Redis deployment.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -------------------------------------------
# Backend (Node.js/Express)
# -------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_API_PREFIX=/api
BACKEND_CORS_ORIGIN=http://localhost:5173
BACKEND_RATE_LIMIT_WINDOW_MS=900000
BACKEND_RATE_LIMIT_MAX=100

# File upload
UPLOAD_MAX_SIZE_MB=2048
UPLOAD_ALLOWED_MIME_TYPES=application/octet-stream,application/x-nifti,application/gzip
UPLOAD_STORAGE_PATH=/app/uploads

# -------------------------------------------
# AI Service (FastAPI)
# -------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_WORKERS=1

# Model storage
MODEL_DIR=/app/models
CACHE_DIR=/app/cache

# -------------------------------------------
# GPU Configuration (RTX 4050 6GB)
# -------------------------------------------
CUDA_VISIBLE_DEVICES=0
MAX_VRAM_GB=5.5
USE_MIXED_PRECISION=true
USE_GRADIENT_CHECKPOINTING=true
USE_TORCH_COMPILE=true
USE_FLASH_ATTENTION=true

# -------------------------------------------
# Preprocessing Defaults
# -------------------------------------------
EEG_TARGET_SR=250
EEG_L_FREQ=0.5
EEG_H_FREQ=100
EEG_NOTCH_FREQ=50

SMRI_TEMPLATE=MNI152_1mm
SMRI_PATCH_SIZE=64
SMRI_PATCH_STRIDE=32

FMRI_TR=2.0
FMRI_SLICE_TIMING=true
FMRI_MOTION_CORRECTION=true
FMRI_SPATIAL_SMOOTHING=6
FMRI_HIGH_PASS=0.01
FMRI_LOW_PASS=0.1
FMRI_PARCELLATION=schaefer_200

# -------------------------------------------
# Frontend (React/Vite)
# -------------------------------------------
# VITE_* values are exposed to the browser.
# Never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:3001/api
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_APP_TITLE=Schizophrenia AI Platform
VITE_DISCLAIMER_TEXT=Research prototype - not for clinical diagnosis. Clinician review required.

# -------------------------------------------
# Nginx (Production Reverse Proxy)
# -------------------------------------------
NGINX_HOST=localhost
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# -------------------------------------------
# Monitoring & Logging (Optional)
# -------------------------------------------
# Configure real credentials in .env or your deployment
# secret manager, never in this example file.
SENTRY_DSN=
DATADOG_API_KEY=
PROMETHEUS_PORT=9090

# -------------------------------------------
# Email (Optional)
# -------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@schizophrenia-ai.local

# -------------------------------------------
# Development / Testing
# -------------------------------------------
# Use only with a dedicated local test database.
# The test runner must validate the target database before
# running integration tests.
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/schizophrenia_ai_test
TEST_REDIS_URL=redis://localhost:6379/1

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# Enabling a feature does not mean its implementation,
# dataset, or model has been validated.
ENABLE_EEG=true
ENABLE_SMRI=true
ENABLE_FMRI=true
ENABLE_FUSION=true
ENABLE_EXPLAINABILITY=true
ENABLE_3D_VIEWER=true
ENABLE_PDF_REPORTS=true

# -------------------------------------------
# Model Versions
# -------------------------------------------
# Identifiers only; these do not imply trained or validated models.
EEG_MODEL_VERSION=eeg_v1.0.0
SMRI_MODEL_VERSION=smri_v1.0.0
FMRI_MODEL_VERSION=fmri_v1.0.0
FUSION_MODEL_VERSION=fusion_v1.0.0
CLINICAL_MODEL_VERSION=clinical_v1.0.0
